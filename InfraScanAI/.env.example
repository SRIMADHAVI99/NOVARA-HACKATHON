# InfraScanAI Environment Variables Configuration
# Copy this file to .env and populate with appropriate configuration values.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
PORT=5000

# Optional Google Maps API Key (Leaflet/OpenStreetMap will be used automatically if omitted or invalid)
GOOGLE_MAPS_API_KEY=
